{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cycle-calendar-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Versioned snapshots live in KV -- deliberately a different storage system from the
  // Durable Objects that hold live state, so one failure cannot take both.
  "kv_namespaces": [
    { "binding": "BACKUPS", "id": "391bc358b6dd4b279d7fb06b6f4ffbae" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "Board" },
      // A single instance holding the list of cycles. Durable Objects cannot be
      // enumerated, so without a registry there is no way to answer "which cycles exist".
      { "name": "CYCLES", "class_name": "Directory" }
    ]
  },

  // SQLite-backed classes are the only Durable Objects available on the Workers
  // free plan. Using new_classes here instead would deploy fine on a paid account
  // and fail on a free one.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Board"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ]
}
